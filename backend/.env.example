SHUANGHUA_ENV=production
SHUANGHUA_HOST=127.0.0.1
PORT=3002
WEB_CONCURRENCY=2
SHUANGHUA_FORWARDED_ALLOW_IPS=127.0.0.1
SHUANGHUA_LOG_LEVEL=INFO
SHUANGHUA_CORS_ORIGINS=https://your-domain.example
SHUANGHUA_IMAGE_READ_TIMEOUT_SECONDS=600
SHUANGHUA_VIDEO_CREATE_TIMEOUT_SECONDS=120
SHUANGHUA_VIDEO_STATUS_TIMEOUT_SECONDS=60
SHUANGHUA_CONNECT_TIMEOUT_SECONDS=15
SHUANGHUA_POOL_TIMEOUT_SECONDS=30
SHUANGHUA_MAX_REDIRECTS=3
SHUANGHUA_MAX_JSON_RESPONSE_BYTES=268435456
